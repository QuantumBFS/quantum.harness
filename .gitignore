skills/requesting-code-review
skills/scientific-visualization
skills/subagent-driven-development
skills/survey
skills/systematic-debugging
skills/test-driven-development
skills/using-git-worktrees
skills/using-superpowers
skills/verification-before-completion
skills/writing-plans
skills/writing-skills

# Claude runtime state
.claude/scheduled_tasks.lock
.claude/cache/
scripts/_*
/results/
/tmp/
/.external/
.venv-tenpy/
.pytest_cache/
.coverage
__pycache__/
target/
.superpowers/
docs/superpowers/

# Per-user cluster profiles (connection secrets: host/IP, user, key paths, local
# paths). Cluster cards (*.md) carry the same identifying info. Every profile
# and card is local-only by default — /setup-cluster writes new ones here
# without touching this file — and the public examples are allow-listed below.
# To publish a new secret-free profile, add a `!` line for it.
skills/using-slurm/profiles/*.toml
skills/using-slurm/profiles/*.md
!skills/using-slurm/profiles/localhost.toml
!skills/using-slurm/profiles/qdeshell.toml
!skills/using-slurm/profiles/scnet.toml
!skills/using-slurm/profiles/*-setup.md

# Git worktrees
.worktrees/

# Cryochamber state — never commit a local chamber
.cryo/

# Managed by ion
skills/brainstorm-ideas
skills/autoresearch-validator
skills/autoresearch
skills/autoresearch-db
skills/autoresearch-run
skills/autoresearch-topics

