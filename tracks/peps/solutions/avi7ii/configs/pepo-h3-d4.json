{
  "model": {
    "lx": 10,
    "ly": 10,
    "j": 1.0,
    "h": 3.0
  },
  "conventions": {
    "boundary": "open",
    "operator": "pauli"
  },
  "evolution": {
    "delta_beta": 0.025,
    "beta_stop": 1.0,
    "max_bond": 4,
    "teacher_bond": 16
  },
