    "max_iterations": 50,
    "optimizer": "L-BFGS-B",
    "tolerances": {
      "z": 1e-5,
      "u": 1e-4,
      "contraction_noise": 1e-7
    },
    "weights": {
      "z": 1.0,
      "u": 1.0,
      "hermiticity": 1.0
    },
    "hermiticity_tolerance": 1e-6,
    "loss_acceptance_tolerance": 1e-10
  },
  "measurement": {
    "chis": [16, 32],
    "public_step": 0.1
  }
}
