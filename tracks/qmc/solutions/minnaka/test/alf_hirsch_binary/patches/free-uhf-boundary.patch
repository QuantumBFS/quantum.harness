+        Subroutine Write_trial_matrix(Filename, Orbitals)
+          Use, Intrinsic :: ieee_arithmetic
+          Implicit none
+          Character(len=*), Intent(in) :: Filename
+          Complex(Kind=Kind(0.d0)), Intent(in) :: Orbitals(:,:)
+          Integer :: unit_number, ios, row, col
+
+          Open(newunit=unit_number, file=Filename, status='replace', action='write', iostat=ios)
+          If (ios /= 0) then
+             Write(error_unit,*) 'Cannot write trial orbital file: ', Trim(Filename)
+             error stop 1
+          Endif
+          Write(unit_number,'(I0,1X,I0)') Size(Orbitals,1), Size(Orbitals,2)
+          Do row = 1,Size(Orbitals,1)
+             Do col = 1,Size(Orbitals,2)
+                If (.not. ieee_is_finite(Real(Orbitals(row,col),Kind(0.d0))) .or. &
+                    Abs(Aimag(Orbitals(row,col))) > 1.d-13) then
+                   Write(error_unit,*) 'Cannot export non-real trial orbital: ', Trim(Filename)
+                   error stop 1
+                Endif
+             Enddo
+             Write(unit_number,'(*(ES25.17E3,1X))') &
+                  (Real(Orbitals(row,col),Kind(0.d0)), col=1,Size(Orbitals,2))
+          Enddo
+          Close(unit_number)
+        End Subroutine Write_trial_matrix
+
+        Subroutine Write_trial_site_map(Filename)
+          Implicit none
+          Character(len=*), Intent(in) :: Filename
+          Integer :: unit_number, ios, site, x, y, cpp_site
+
+          Open(newunit=unit_number, file=Filename, status='replace', action='write', iostat=ios)
+          If (ios /= 0) then
+             Write(error_unit,*) 'Cannot write trial site map: ', Trim(Filename)
+             error stop 1
+          Endif
+          Do site = 1,Ndim
+             x = Modulo(Latt%list(site,1),L1)
+             y = Modulo(Latt%list(site,2),L2)
+             cpp_site = x + L1*y
+             Write(unit_number,'(I0,1X,I0,1X,I0,1X,I0)') site, cpp_site, x, y
+          Enddo
+          Close(unit_number)
+        End Subroutine Write_trial_site_map
+
+        Subroutine Read_trial_matrix(Filename, Orbitals, Residual)
+          Use, Intrinsic :: ieee_arithmetic
+          Implicit none
+          Character(len=*), Intent(in) :: Filename
+          Complex(Kind=Kind(0.d0)), Intent(out) :: Orbitals(:,:)
+          Real(Kind=Kind(0.d0)), Intent(out) :: Residual
+          Integer :: unit_number, ios, rows, cols, row, col, left, right
+          Real(Kind=Kind(0.d0)), Allocatable :: values(:,:)
+          Real(Kind=Kind(0.d0)) :: extra_value
+          Complex(Kind=Kind(0.d0)) :: gram_value
+
+          Open(newunit=unit_number, file=Filename, status='old', action='read', iostat=ios)
+          If (ios /= 0) then
+             Write(error_unit,*) 'Cannot open trial orbital file: ', Trim(Filename)
+             error stop 1
+          Endif
+          Read(unit_number,*,iostat=ios) rows, cols
+          If (ios /= 0 .or. rows /= Size(Orbitals,1) .or. cols /= Size(Orbitals,2)) then
+             Write(error_unit,*) 'Invalid trial_T orbital shape in ', Trim(Filename)
+             error stop 1
+          Endif
+          Allocate(values(rows,cols))
+          Do row = 1,rows
+             Read(unit_number,*,iostat=ios) (values(row,col),col=1,cols)
+             If (ios /= 0) then
+                Write(error_unit,*) 'Invalid trial_T orbital data in ', Trim(Filename)
+                error stop 1
+             Endif
+          Enddo
+          Read(unit_number,*,iostat=ios) extra_value
+          If (ios == 0) then
+             Write(error_unit,*) 'Extra trial_T orbital data in ', Trim(Filename)
+             error stop 1
+          Endif
+          Close(unit_number)
+          If (Any(.not. ieee_is_finite(values))) then
+             Write(error_unit,*) 'Nonfinite trial_T orbital in ', Trim(Filename)
+             error stop 1
+          Endif
+          Orbitals = Cmplx(values,0.d0,Kind(0.d0))
+          Residual = 0.d0
+          Do left = 1,cols
+             Do right = 1,cols
+                gram_value = Sum(Conjg(Orbitals(:,left))*Orbitals(:,right))
+                If (left == right) gram_value = gram_value - 1.d0
+                Residual = Max(Residual,Abs(gram_value))
+             Enddo
+          Enddo
+          If (Residual >= 1.d-11) then
+             Write(error_unit,*) 'Nonorthogonal trial_T orbital in ', Trim(Filename), Residual
+             error stop 1
+          Endif
+          Deallocate(values)
+        End Subroutine Read_trial_matrix
+
+        Real(Kind=Kind(0.d0)) Function Trial_overlap_determinant(Left,Right)
+          Implicit none
+          Complex(Kind=Kind(0.d0)), Intent(in) :: Left(:,:), Right(:,:)
+          Complex(Kind=Kind(0.d0)), Allocatable :: overlap_matrix(:,:)
+          Complex(Kind=Kind(0.d0)) :: overlap
+
+          Allocate(overlap_matrix(Size(Left,2),Size(Right,2)))
+          overlap_matrix = Matmul(Conjg(Transpose(Left)),Right)
+          overlap = Det(overlap_matrix,Size(Left,2))
+          If (Abs(Aimag(overlap)) > 1.d-12) then
+             Write(error_unit,*) 'Complex trial_T overlap is unsupported'
+             error stop 1
+          Endif
+          Trial_overlap_determinant = Real(overlap,Kind(0.d0))
+          Deallocate(overlap_matrix)
+        End Function Trial_overlap_determinant
+
