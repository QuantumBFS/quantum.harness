+module Path_archive_mod
+  use iso_fortran_env, only: int8, int32, int64, real64, error_unit
+  use ieee_arithmetic, only: ieee_value, ieee_quiet_nan
+  use UDV_State_mod, only: UDV_State
+  implicit none
+  private
+
+  integer, parameter :: header_bytes = 256
+  integer, parameter :: record_prefix_bytes = 108
+  integer :: archive_unit = -1
+  integer(int32) :: archive_ltrot = 0
+  integer(int32) :: archive_nsites = 0
+  integer(int32) :: archive_nfield = 0
+  integer(int32) :: archive_payload_bytes = 0
+  integer(int32) :: archive_record_bytes = 0
+  integer(int32) :: archive_chain = 0
+  integer(int8) :: archive_ensemble = 0
+  integer(int64) :: local_sequence = 0_int64
+  logical :: archive_is_open = .false.
+
+  public :: path_archive_open, path_archive_close
+  public :: path_archive_write, path_endpoint_signed_log
+  public :: path_udv_logabs
+
+contains
+
+  pure integer(int8) function byte_value(value)
+    integer(int32), intent(in) :: value
+    integer(int32) :: normalized
+    normalized = iand(value, int(z'000000ff', int32))
+    if (normalized <= 127_int32) then
+      byte_value = int(normalized, int8)
+    else
+      byte_value = int(normalized - 256_int32, int8)
+    endif
+  end function byte_value
+
+  pure subroutine put_u16(buffer, offset, value)
+    integer(int8), intent(inout) :: buffer(:)
+    integer, intent(in) :: offset
+    integer(int32), intent(in) :: value
+    integer :: index
+    do index = 0, 1
+      buffer(offset + index) = byte_value(shiftr(value, 8 * index))
+    enddo
+  end subroutine put_u16
+
+  pure subroutine put_u32(buffer, offset, value)
+    integer(int8), intent(inout) :: buffer(:)
+    integer, intent(in) :: offset
+    integer(int32), intent(in) :: value
+    integer :: index
+    do index = 0, 3
+      buffer(offset + index) = byte_value(shiftr(value, 8 * index))
+    enddo
+  end subroutine put_u32
+
+  pure subroutine put_u64(buffer, offset, value)
+    integer(int8), intent(inout) :: buffer(:)
+    integer, intent(in) :: offset
+    integer(int64), intent(in) :: value
+    integer :: index
+    do index = 0, 7
+      buffer(offset + index) = byte_value( &
+        int(iand(shiftr(value, 8 * index), int(z'ff', int64)), int32))
+    enddo
+  end subroutine put_u64
+
+  pure subroutine put_real64(buffer, offset, value)
+    integer(int8), intent(inout) :: buffer(:)
+    integer, intent(in) :: offset
+    real(real64), intent(in) :: value
+    call put_u64(buffer, offset, transfer(value, 0_int64))
+  end subroutine put_real64
+
+  pure subroutine put_ascii(buffer, offset, value)
+    integer(int8), intent(inout) :: buffer(:)
+    integer, intent(in) :: offset
+    character(len=*), intent(in) :: value
+    integer :: index
+    do index = 1, len(value)
+      buffer(offset + index - 1) = byte_value(int(iachar(value(index:index)), int32))
+    enddo
+  end subroutine put_ascii
+
+  pure integer(int32) function crc32_bytes(buffer)
+    integer(int8), intent(in) :: buffer(:)
+    integer(int32) :: crc
+    integer :: index, bit
+    crc = not(0_int32)
+    do index = 1, size(buffer)
+      crc = ieor(crc, iand(int(buffer(index), int32), int(z'ff', int32)))
+      do bit = 1, 8
+        if (btest(crc, 0)) then
+          crc = ieor(shiftr(crc, 1), int(z'edb88320', int32))
+        else
+          crc = shiftr(crc, 1)
+        endif
+      enddo
+    enddo
+    crc32_bytes = not(crc)
+  end function crc32_bytes
+
+  subroutine path_archive_open(filename, lx, ly, n_up, n_down, ltrot, &
+       hopping, interaction, dt, beta, theta, ensemble, chain_id, &
+       selected_hash, trial_hash)
+    character(len=*), intent(in) :: filename
+    integer, intent(in) :: lx, ly, n_up, n_down, ltrot, ensemble, chain_id
+    real(real64), intent(in) :: hopping, interaction, dt, beta, theta
+    character(len=*), intent(in) :: selected_hash, trial_hash
+    integer(int8) :: header(header_bytes), existing(header_bytes)
+    integer(int64) :: file_size, payload_size
+    integer :: index, io_status, read_unit
+    logical :: exists
+
+    if (archive_is_open) error stop 'path archive already open'
+    if (len_trim(selected_hash) /= 64 .or. len_trim(trial_hash) /= 64) &
+      error stop 'path archive hashes must contain 64 characters'
+    if (ensemble < 1 .or. ensemble > 2) &
+      error stop 'Archive_ensemble must be 1 or 2'
+    if (chain_id < 0 .or. chain_id >= 2048) &
+      error stop 'Archive_chain_id must be in [0,2048)'
+    if (ltrot <= 0 .or. lx <= 0 .or. ly <= 0) &
+      error stop 'invalid path archive dimensions'
+
+    archive_ltrot = int(ltrot, int32)
+    archive_nsites = int(lx * ly, int32)
+    archive_nfield = archive_ltrot * archive_nsites
+    archive_payload_bytes = (archive_nfield + 7_int32) / 8_int32
+    archive_record_bytes = ((record_prefix_bytes + archive_payload_bytes + 4 + 63) / 64) * 64
+    archive_chain = int(chain_id, int32)
+    archive_ensemble = int(ensemble, int8)
+
+    header = 0_int8
+    call put_ascii(header, 1, 'QHPATH01')
+    call put_u32(header, 9, 1_int32)
+    call put_u32(header, 13, int(z'01020304', int32))
+    call put_u32(header, 17, int(header_bytes, int32))
+    call put_u32(header, 21, archive_record_bytes)
+    call put_u32(header, 25, int(lx, int32))
+    call put_u32(header, 29, int(ly, int32))
+    call put_u32(header, 33, int(n_up, int32))
+    call put_u32(header, 37, int(n_down, int32))
+    call put_u32(header, 41, archive_ltrot)
+    call put_u32(header, 45, archive_nsites)
+    call put_u32(header, 49, archive_nfield)
+    call put_u32(header, 53, archive_payload_bytes)
+    call put_real64(header, 57, hopping)
+    call put_real64(header, 65, interaction)
+    call put_real64(header, 73, dt)
+    call put_real64(header, 81, beta)
+    call put_real64(header, 89, theta)
+    header(97) = archive_ensemble
+    header(98) = 1_int8
+    header(99) = 1_int8
+    call put_ascii(header, 101, selected_hash(1:64))
+    call put_ascii(header, 165, trial_hash(1:64))
+
+    inquire(file=trim(filename), exist=exists, size=file_size)
+    if (exists) then
+      if (file_size < header_bytes) error stop 'truncated path archive header'
+      open(newunit=read_unit, file=trim(filename), access='stream', &
+           form='unformatted', status='old', action='read', iostat=io_status)
+      if (io_status /= 0) error stop 'cannot read existing path archive'
+      read(read_unit, iostat=io_status) existing
+      close(read_unit)
+      if (io_status /= 0 .or. any(existing /= header)) &
+        error stop 'existing path archive header mismatch'
+      payload_size = file_size - int(header_bytes, int64)
+      if (mod(payload_size, int(archive_record_bytes, int64)) /= 0_int64) &
+        error stop 'path archive has a truncated record'
+      local_sequence = payload_size / int(archive_record_bytes, int64)
+      open(newunit=archive_unit, file=trim(filename), access='stream', &
+           form='unformatted', status='old', position='append', &
+           action='write', iostat=io_status)
+    else
+      local_sequence = 0_int64
+      open(newunit=archive_unit, file=trim(filename), access='stream', &
+           form='unformatted', status='new', action='write', iostat=io_status)
+      if (io_status == 0) write(archive_unit) header
+    endif
+    if (io_status /= 0) error stop 'cannot open path archive for writing'
+    archive_is_open = .true.
+  end subroutine path_archive_open
+
+  subroutine path_archive_close()
+    if (archive_is_open) close(archive_unit)
+    archive_unit = -1
+    archive_is_open = .false.
+  end subroutine path_archive_close
+
+  subroutine path_archive_write(bin_id, sweep_id, frozen_sign, central, &
+       endpoint_sign, endpoint_logabs, endpoint, field_values)
+    integer, intent(in) :: bin_id, frozen_sign, endpoint_sign
+    integer(int64), intent(in) :: sweep_id
+    real(real64), intent(in) :: central(4), endpoint_logabs, endpoint(3)
+    real(real64), intent(in) :: field_values(:,:)
+    integer(int8), allocatable :: record(:)
+    integer(int32) :: crc
+    integer(int64) :: sample_id
+    integer :: site, slice, field_index, payload_index, bit_index
+
+    if (.not. archive_is_open) error stop 'path archive is not open'
+    if (size(field_values, 1) /= archive_nsites .or. &
+        size(field_values, 2) /= archive_ltrot) &
+      error stop 'path archive field dimensions do not match header'
+    local_sequence = local_sequence + 1_int64
+    if (local_sequence >= shiftl(1_int64, 49)) &
+      error stop 'path archive local sequence overflow'
+    sample_id = ior(shiftl(int(archive_ensemble, int64), 60), &
+                    ior(shiftl(int(archive_chain, int64), 49), local_sequence))
+    allocate(record(archive_record_bytes))
+    record = 0_int8
+    call put_u64(record, 1, sample_id)
+    call put_u32(record, 9, archive_chain)
+    call put_u32(record, 13, int(bin_id, int32))
+    call put_u64(record, 17, sweep_id)
+    call put_u32(record, 25, archive_ltrot)
+    call put_u32(record, 29, archive_nfield)
+    record(33) = int(frozen_sign, int8)
+    record(34) = 1_int8
+    call put_u16(record, 35, 0_int32)
+    call put_real64(record, 37, central(1))
+    call put_real64(record, 45, central(2))
+    call put_real64(record, 53, central(3))
+    call put_real64(record, 61, central(4))
+    record(69) = int(endpoint_sign, int8)
+    call put_real64(record, 77, endpoint_logabs)
+    call put_real64(record, 85, endpoint(1))
+    call put_real64(record, 93, endpoint(2))
+    call put_real64(record, 101, endpoint(3))
+
+    field_index = 0
+    do slice = 1, archive_ltrot
+      do site = 1, archive_nsites
+        if (nint(field_values(site, slice)) /= -1 .and. &
+            nint(field_values(site, slice)) /= 1) &
+          error stop 'path archive requires binary fields'
+        if (nint(field_values(site, slice)) == 1) then
+          payload_index = record_prefix_bytes + 1 + field_index / 8
+          bit_index = mod(field_index, 8)
+          record(payload_index) = byte_value(ior( &
+            iand(int(record(payload_index), int32), int(z'ff', int32)), &
+            shiftl(1_int32, bit_index)))
+        endif
+        field_index = field_index + 1
+      enddo
+    enddo
+    crc = crc32_bytes(record(1:record_prefix_bytes + archive_payload_bytes))
+    call put_u32(record, record_prefix_bytes + archive_payload_bytes + 1, crc)
+    write(archive_unit) record
+    flush(archive_unit)
+    deallocate(record)
+  end subroutine path_archive_write
+
+  subroutine path_endpoint_signed_log(udvl, udvr, n_sun, sign_value, logabs_value)
+    class(UDV_State), intent(in) :: udvl(:), udvr(:)
+    integer, intent(in) :: n_sun
+    integer, intent(out) :: sign_value
+    real(real64), intent(out) :: logabs_value
+    complex(real64), allocatable :: overlap(:,:)
+    complex(real64) :: phase
+    integer, allocatable :: pivots(:)
+    integer :: flavor, index, info, part
+
+    if (size(udvl) /= size(udvr)) error stop 'endpoint flavor mismatch'
+    phase = cmplx(1.0_real64, 0.0_real64, real64)
+    logabs_value = 0.0_real64
+    do flavor = 1, size(udvr)
+      part = udvr(flavor)%n_part
+      if (udvl(flavor)%n_part /= part) error stop 'endpoint particle mismatch'
+      allocate(overlap(part, part), pivots(part))
+      overlap = matmul(conjg(transpose(udvl(flavor)%U)), udvr(flavor)%U)
+      call zgetrf(part, part, overlap, part, pivots, info)
+      if (info /= 0) then
+        sign_value = 0
+        logabs_value = -huge(1.0_real64)
+        deallocate(overlap, pivots)
+        return
+      endif
+      do index = 1, part
+        if (pivots(index) /= index) phase = -phase
+        phase = phase * overlap(index,index) / abs(overlap(index,index))
+        logabs_value = logabs_value + log(abs(overlap(index,index)))
+      enddo
+      deallocate(overlap, pivots)
+    enddo
+    phase = phase ** n_sun
+    logabs_value = logabs_value * real(n_sun, real64)
+    if (abs(aimag(phase)) > 1.0e-8_real64) &
+      error stop 'complex endpoint phase in real path archive'
+    if (real(phase, real64) > 0.0_real64) then
+      sign_value = 1
+    else if (real(phase, real64) < 0.0_real64) then
+      sign_value = -1
+    else
+      sign_value = 0
+      logabs_value = ieee_value(logabs_value, ieee_quiet_nan)
+    endif
+  end subroutine path_endpoint_signed_log
+
+  real(real64) function path_udv_logabs(states)
+    class(UDV_State), intent(in) :: states(:)
+    complex(real64) :: scale
+    integer :: flavor, index
+    path_udv_logabs = 0.0_real64
+    do flavor = 1, size(states)
+      do index = 1, states(flavor)%n_part
+        call states(flavor)%getscale(scale, index)
+        path_udv_logabs = path_udv_logabs + log(abs(scale))
+      enddo
+    enddo
+  end function path_udv_logabs
+
+end module Path_archive_mod
