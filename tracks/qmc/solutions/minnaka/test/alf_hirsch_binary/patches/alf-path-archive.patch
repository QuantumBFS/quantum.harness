+             flavor = Calc_Fl_map(flavor_eff)
+             call frozen_right(flavor_eff)%init(Ndim, 'r', WF_R(flavor)%P)
+             call frozen_left(flavor_eff)%init(Ndim, 'l', WF_L(flavor)%P)
+          enddo
+
+          center = Ltrot / 2
+          right_logabs = 0.d0
+          current = 0
+          do while (current < center)
+             next_slice = min(current + Nwrap, center)
+             call WRAPUR(current, next_slice, frozen_right)
+             right_logabs = right_logabs + path_udv_logabs(frozen_right)
+             current = next_slice
+          enddo
+          current = Ltrot
+          do while (current > center)
+             next_slice = max(current - Nwrap, center)
+             call WRAPUL(current, next_slice, frozen_left)
+             current = next_slice
+          enddo
+
+          frozen_phases = cmplx(1.d0, 0.d0, kind(0.d0))
+          nvar_local = 1
+          if (center > Ltrot/2) nvar_local = 2
+          do flavor_eff = 1, N_FL_eff
+             flavor = Calc_Fl_map(flavor_eff)
+             call CGR(phase_one, nvar_local, frozen_gr(:,:,flavor), &
+                      frozen_right(flavor_eff), frozen_left(flavor_eff))
+             call Op_phase(phase_one, OP_V, nsigma, flavor)
+             frozen_phases(flavor) = phase_one
+          enddo
+          if (reconstruction_needed) call ham%weight_reconstruction(frozen_phases)
+          phase_total = product(frozen_phases)
+          phase_total = phase_total ** N_SUN
+          if (abs(aimag(phase_total)) > 1.d-8) &
+               error stop 'complex frozen phase in real archive'
+          frozen_sign = merge(1, -1, real(phase_total,kind(0.d0)) >= 0.d0)
+          if (Symm) then
+             call Hop_mod_Symm(frozen_tilde, frozen_gr)
+             if (reconstruction_needed) call ham%GR_reconstruction(frozen_tilde)
+             call ham%Frozen_scalars(frozen_tilde, central(1), central(2), &
+                                     central(3), central(4))
+          else
+             if (reconstruction_needed) call ham%GR_reconstruction(frozen_gr)
+             call ham%Frozen_scalars(frozen_gr, central(1), central(2), &
+                                     central(3), central(4))
+          endif
+
+          current = center
+          do while (current < Ltrot)
+             next_slice = min(current + Nwrap, Ltrot)
+             call WRAPUR(current, next_slice, frozen_right)
+             right_logabs = right_logabs + path_udv_logabs(frozen_right)
+             current = next_slice
+          enddo
+          do flavor_eff = 1, N_FL_eff
+             flavor = Calc_Fl_map(flavor_eff)
+             call frozen_left(flavor_eff)%reset('l', WF_L(flavor)%P)
+          enddo
+          frozen_gr = cmplx(0.d0, 0.d0, kind(0.d0))
+          frozen_phases = cmplx(1.d0, 0.d0, kind(0.d0))
+          do flavor_eff = 1, N_FL_eff
+             flavor = Calc_Fl_map(flavor_eff)
+             call CGR(phase_one, 2, frozen_gr(:,:,flavor), &
+                      frozen_right(flavor_eff), frozen_left(flavor_eff))
+             call Op_phase(phase_one, OP_V, nsigma, flavor)
+             frozen_phases(flavor) = phase_one
+          enddo
+          if (reconstruction_needed) call ham%weight_reconstruction(frozen_phases)
