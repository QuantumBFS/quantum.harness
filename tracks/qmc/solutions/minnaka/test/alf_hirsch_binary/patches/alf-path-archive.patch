+          integer :: nvar_local, endpoint_sign, frozen_sign
+
+          allocate(frozen_left(N_FL_eff), frozen_right(N_FL_eff))
+          allocate(frozen_gr(Ndim,Ndim,N_FL), frozen_tilde(Ndim,Ndim,N_FL))
