+      contains
+
+        subroutine Write_frozen_archive(bin_id, sweep_id)
+          integer, intent(in) :: bin_id
+          integer(int64), intent(in) :: sweep_id
+          class(UDV_State), allocatable :: frozen_left(:), frozen_right(:)
+          complex(Kind=Kind(0.d0)), allocatable :: frozen_gr(:,:,:)
+          complex(Kind=Kind(0.d0)), allocatable :: frozen_tilde(:,:,:)
+          complex(Kind=Kind(0.d0)), allocatable :: frozen_phases(:)
+          complex(Kind=Kind(0.d0)) :: phase_one, phase_total
+          real(Kind=Kind(0.d0)) :: central(4), endpoint(3)
+          real(Kind=Kind(0.d0)) :: endpoint_logabs
+          real(Kind=Kind(0.d0)) :: endpoint_npart
+          real(Kind=Kind(0.d0)) :: right_logabs
