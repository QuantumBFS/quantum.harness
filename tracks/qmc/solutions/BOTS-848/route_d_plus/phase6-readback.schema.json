{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "challenge-15-route-d-plus-phase6-readback-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at_utc",
    "final_certificate",
    "source_revision",
    "checks",
    "passed"
  ],
  "properties": {
    "schema_version": {
      "const": "challenge-15-route-d-plus-phase6-readback-v1"
    },
    "created_at_utc": {"type": "string", "format": "date-time"},
    "final_certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_schema_valid",
        "source_revision",
        "source_clean",
        "all_artifact_hashes",
        "all_artifact_schemas",
        "exact_seed_set"
      ],
      "properties": {
        "final_schema_valid": {"const": true},
        "source_revision": {"const": true},
        "source_clean": {"const": true},
        "all_artifact_hashes": {"const": true},
        "all_artifact_schemas": {"const": true},
        "exact_seed_set": {"const": true}
      }
    },
    "passed": {"const": true}
  }
}
