{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "challenge-15-route-d-plus-future-task-certificate-v1",
  "title": "Route D+ isolated future-stage task certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "task_id",
    "kind",
    "run_dir",
    "source_revision",
    "git_dirty",
    "started_at_utc",
    "finished_at_utc",
    "input_artifacts",
    "slurm",
    "logs",
    "domain_certificate",
    "gates",
    "passed"
  ],
  "properties": {
    "schema_version": {
      "const": "challenge-15-route-d-plus-future-task-certificate-v1"
    },
    "stage": {
      "enum": ["phase7", "phase8", "phase9", "phase10", "phase11"]
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "kind": {
      "enum": [
        "ed-sector",
        "overlap",
        "span-ceiling",
        "dplus1-seed",
        "dplus2-seed",
        "heldout-ed",
        "chirality",
        "beyond-ed"
      ]
    },
    "run_dir": {"type": "string", "minLength": 2},
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "git_dirty": {"const": false},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "finished_at_utc": {"type": "string", "format": "date-time"},
    "input_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "slurm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "cluster_name",
        "node_list",
        "partition",
        "gpu_devices",
        "cpus_per_task",
        "memory_mb",
        "elapsed_seconds",
        "exit_code"
      ],
      "properties": {
        "job_id": {"type": "string", "minLength": 1},
        "cluster_name": {"type": "string", "minLength": 1},
        "node_list": {"type": "string", "minLength": 1},
        "partition": {"type": "string", "minLength": 1},
        "gpu_devices": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "cpus_per_task": {"type": "integer", "minimum": 1},
        "memory_mb": {"type": "integer", "minimum": 1},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "exit_code": {"const": 0}
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stdout", "stderr"],
      "properties": {
        "stdout": {"$ref": "#/$defs/artifact"},
        "stderr": {"$ref": "#/$defs/artifact"}
      }
    },
    "domain_certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "schema_path",
        "schema_sha256",
        "schema_valid"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_path": {"type": "string", "minLength": 1},
        "schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_valid": {"const": true}
      }
    },
    "checkpoint": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/artifact"}
      ]
    },
    "gates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"const": true}
    },
    "passed": {"const": true}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
