{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "challenge-15-route-d-plus-phase6-v1",
  "title": "Route D+ Phase 6 blind D+0 training certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at_utc",
    "n_electrons",
    "two_q",
    "ansatz",
    "seeds",
    "seed_results",
    "checkpoints",
    "architecture",
    "blind_access_audit",
    "gates",
    "passed",
    "ed_accessed",
    "forbidden_module_prefixes",
    "forbidden_modules_loaded",
    "forbidden_source_references",
    "runtime_seconds",
    "jax_device",
    "jax_platform",
    "jax_x64_enabled",
    "git_commit",
    "git_dirty",
    "hostname",
    "slurm_job_id",
    "slurm_cluster_name",
    "phase5_certificate_path",
    "phase5_certificate_sha256",
    "phase5_git_commit"
  ],
  "properties": {
    "schema_version": {"const": "challenge-15-route-d-plus-phase6-v1"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "n_electrons": {"const": 6},
    "two_q": {"const": 15},
    "ansatz": {"const": "D+0-linear-scalar"},
    "seeds": {
      "type": "array",
      "prefixItems": [{"const": 848}, {"const": 1848}, {"const": 2848}],
      "items": false
    },
    "seed_results": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "seed",
          "initialization_norm",
          "retained_generators",
          "architecture_sha256",
          "trace",
          "initial_objective",
          "final_training_objective",
          "final_ground",
          "final_tower",
          "final_gap",
          "final_gap_standard_error"
        ],
        "properties": {
          "seed": {"enum": [848, 1848, 2848]},
          "initialization_norm": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 0.02
          },
          "retained_generators": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "architecture_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "trace": {
            "type": "array",
            "minItems": 24,
            "maxItems": 24,
            "items": {"$ref": "#/$defs/update_record"}
          },
          "initial_objective": {"type": "number"},
          "final_training_objective": {"type": "number"},
          "final_ground": {"$ref": "#/$defs/sector_statistics"},
          "final_tower": {"$ref": "#/$defs/sector_statistics"},
          "final_gap": {"type": "number"}
          ,
          "final_gap_standard_error": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.005
          }
        },
        "additionalProperties": false
      }
    },
    "checkpoints": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "seed",
          "path",
          "sha256",
          "selection",
          "architecture_sha256",
          "schema_path",
          "schema_sha256",
          "symmetry_path",
          "symmetry_sha256",
          "symmetry_schema_sha256"
        ],
        "properties": {
          "seed": {"enum": [848, 1848, 2848]},
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "selection": {"const": "final_update"},
          "architecture_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "schema_path": {"type": "string", "minLength": 1},
          "schema_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "symmetry_path": {"type": "string", "minLength": 1},
          "symmetry_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "symmetry_schema_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "three_seed_training",
        "identity_initialization",
        "finite_statistics",
        "sampling_acceptance",
        "effective_samples",
        "gap_precision",
        "rotation_invariance",
        "checkpoint_symmetry",
        "blind_training",
        "shared_frozen_architecture",
        "combined_state_averaged_sr",
        "final_checkpoint_selection"
      ],
      "properties": {
        "three_seed_training": {"const": true},
        "identity_initialization": {"const": true},
        "finite_statistics": {"const": true},
        "sampling_acceptance": {"const": true},
        "effective_samples": {"const": true},
        "gap_precision": {"const": true},
        "rotation_invariance": {"const": true},
        "checkpoint_symmetry": {"const": true},
        "blind_training": {"const": true},
        "shared_frozen_architecture": {"const": true},
        "combined_state_averaged_sr": {"const": true},
        "final_checkpoint_selection": {"const": true}
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "retained_generators",
        "selection_rule",
        "schema_path",
        "schema_sha256"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "retained_generators": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "selection_rule": {
          "const": "algebraic-covariance-cutoff-only-no-ed"
        },
        "schema_path": {"type": "string", "minLength": 1},
        "schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "blind_access_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "denied_events"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "denied_events": {"const": 0}
      }
    },
    "passed": {"const": true},
    "ed_accessed": {"const": false},
    "forbidden_module_prefixes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "string"}
    },
    "forbidden_modules_loaded": {"type": "array", "maxItems": 0},
    "forbidden_source_references": {"type": "array", "maxItems": 0},
    "runtime_seconds": {"type": "number", "exclusiveMinimum": 0},
    "jax_device": {"type": "string", "minLength": 1},
    "jax_platform": {"const": "gpu"},
    "jax_x64_enabled": {"const": true},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "git_dirty": {"const": false},
    "hostname": {"type": "string"},
    "slurm_job_id": {"type": ["string", "null"]},
    "slurm_cluster_name": {"type": ["string", "null"]},
    "phase5_certificate_path": {"type": "string"},
    "phase5_certificate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase5_git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  },
  "$defs": {
    "update_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "update",
        "ground",
        "tower",
        "objective",
        "combined_gradient_norm",
        "combined_step_norm",
        "metric_structure"
      ],
      "properties": {
        "update": {"type": "integer", "minimum": 1, "maximum": 24},
        "ground": {"$ref": "#/$defs/training_sector"},
        "tower": {"$ref": "#/$defs/training_sector"},
        "objective": {"type": "number"},
        "combined_gradient_norm": {"type": "number", "minimum": 0},
        "combined_step_norm": {"type": "number", "minimum": 0},
        "metric_structure": {
          "const": "equal-weight-block-diagonal-shared-solve"
        }
      }
    },
    "training_sector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "energy",
        "gradient_norm",
        "step_norm",
        "correction_acceptance",
        "mother_acceptance",
        "global_rotation_residual"
      ],
      "properties": {
        "energy": {"type": "number"},
        "gradient_norm": {"type": "number", "minimum": 0},
        "step_norm": {"type": "number", "minimum": 0},
        "correction_acceptance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mother_acceptance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "global_rotation_residual": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "sector_statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mean",
        "standard_error",
        "integrated_autocorrelation_time",
        "effective_sample_size",
        "r_hat",
        "correction_acceptance",
        "mother_acceptance",
        "per_chain_correction_acceptance",
        "per_chain_mother_acceptance",
        "global_rotation_residual",
        "block_size",
        "block_means",
        "wall_seconds",
        "ess_per_second"
      ],
      "properties": {
        "mean": {"type": "number"},
        "standard_error": {"type": "number", "minimum": 0},
        "integrated_autocorrelation_time": {
          "type": "number",
          "minimum": 1
        },
        "effective_sample_size": {"type": "number", "minimum": 32},
        "r_hat": {"type": "number", "exclusiveMaximum": 1.2},
        "correction_acceptance": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "mother_acceptance": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 0.8
        },
        "per_chain_correction_acceptance": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "per_chain_mother_acceptance": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "global_rotation_residual": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1e-7
        },
        "block_size": {"type": "integer", "minimum": 1},
        "block_means": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "number"}
          }
        },
        "wall_seconds": {"type": "number", "exclusiveMinimum": 0},
        "ess_per_second": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
