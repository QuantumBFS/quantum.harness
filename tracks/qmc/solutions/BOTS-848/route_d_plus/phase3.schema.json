{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "challenge-15-route-d-plus-phase3-v1",
  "title": "Route D+ Phase 3 projected tensor algebra certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at_utc",
    "two_q",
    "tensor_count",
    "tolerances",
    "max_errors",
    "passed",
    "git_commit",
    "git_dirty",
    "hostname",
    "slurm_job_id",
    "slurm_cluster_name",
    "phase2_certificate_path",
    "phase2_certificate_sha256",
    "phase2_git_commit"
  ],
  "properties": {
    "schema_version": {"const": "challenge-15-route-d-plus-phase3-v1"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "two_q": {"const": 15},
    "tensor_count": {"const": 256},
    "tolerances": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hilbert_schmidt",
        "hermiticity",
        "finite_rotation",
        "quadrature_reconstruction",
        "one_body_kernel",
        "one_body_action"
      ],
      "properties": {
        "hilbert_schmidt": {"const": 1e-12},
        "hermiticity": {"const": 1e-12},
        "finite_rotation": {"const": 1e-6},
        "quadrature_reconstruction": {"const": 1e-12},
        "one_body_kernel": {"const": 1e-12},
        "one_body_action": {"const": 1e-12}
      }
    },
    "max_errors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hilbert_schmidt",
        "hermiticity",
        "finite_rotation",
        "quadrature_reconstruction",
        "one_body_kernel",
        "one_body_action"
      ],
      "properties": {
        "hilbert_schmidt": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1e-12
        },
        "hermiticity": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1e-12
        },
        "finite_rotation": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1e-6
        },
        "quadrature_reconstruction": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1e-12
        },
        "one_body_kernel": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1e-12
        },
        "one_body_action": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1e-12
        }
      }
    },
    "passed": {"const": true},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "git_dirty": {"const": false},
    "hostname": {"type": "string"},
    "slurm_job_id": {"type": ["string", "null"]},
    "slurm_cluster_name": {"type": ["string", "null"]},
    "phase2_certificate_path": {"type": "string"},
    "phase2_certificate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase2_git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
