{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Challenge 148 immutable run completion manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifacts", "run_id", "run_spec_sha256"],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "not": {
          "enum": [".", "..", "completion.json"]
        },
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?($|/)).+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "size"],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
