{
  "$defs": {
    "allocation": {
      "additionalProperties": false,
      "properties": {
        "adapter_timeout_seconds": {"const": 3600},
        "cores_per_cell": {"const": 2},
        "max_concurrency": {"const": 16},
        "memory_mb_per_cell": {"const": 6000}
      },
      "required": ["adapter_timeout_seconds", "cores_per_cell", "memory_mb_per_cell", "max_concurrency"],
      "type": "object"
    },
    "build_info": {
      "additionalProperties": false,
      "properties": {
        "adapter": {"const": "QMC_SSE"},
        "build_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "codegen_units": {"minLength": 1, "type": "string"},
        "compiler": {"minLength": 1, "type": "string"},
        "encoded_rustflags": {"type": "string"},
        "features": {"type": "string"},
        "lto": {"minLength": 1, "type": "string"},
        "panic": {"minLength": 1, "type": "string"},
        "profile": {"minLength": 1, "type": "string"},
        "qmc_revision": {"minLength": 1, "type": "string"},
        "rng": {"minLength": 1, "type": "string"},
        "seed_derivation": {"minLength": 1, "type": "string"},
        "source_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "sweep_semantics": {"minLength": 1, "type": "string"},
        "target": {"minLength": 1, "type": "string"}
      },
      "required": ["adapter", "build_hash", "source_hash"],
      "type": "object"
    },
    "cell": {
      "additionalProperties": false,
      "properties": {
        "beta": {"exclusiveMinimum": 0, "type": "number"},
        "beta_decimal": {"pattern": "^[0-9]+\\.[0-9]+$", "type": "string"},
        "cell_id": {"pattern": "^paper-(triangular|honeycomb)-l(06|08|10|12|14|16|18|20)-f[0-4]-c[01]$", "type": "string"},
        "chain_index": {"maximum": 1, "minimum": 0, "type": "integer"},
        "field": {"exclusiveMinimum": 0, "type": "number"},
        "field_center_decimal": {"enum": ["4.76811", "2.13250"], "type": "string"},
        "field_decimal": {"pattern": "^[0-9]+\\.[0-9]+$", "type": "string"},
        "field_factor_decimal": {"enum": ["0.995", "0.9975", "1.0", "1.0025", "1.005"], "type": "string"},
        "field_index": {"maximum": 4, "minimum": 0, "type": "integer"},
        "graph_path": {"pattern": "^graphs/[0-9a-f]{64}\\.json$", "type": "string"},
        "graph_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "lattice": {"enum": ["honeycomb", "triangular"], "type": "string"},
        "length": {"enum": [6, 8, 10, 12, 14, 16, 18, 20], "type": "integer"},
        "request": {"type": "object"},
        "request_path": {"pattern": "^requests/paper-[a-z0-9-]+\\.json$", "type": "string"},
        "request_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "seed": {"maximum": 18446744073709551615, "minimum": 0, "type": "integer"}
      },
      "required": ["cell_id", "lattice", "length", "field_index", "field_factor_decimal", "field_center_decimal", "field_decimal", "field", "beta_decimal", "beta", "chain_index", "seed", "graph_path", "graph_sha256", "request_path", "request_sha256", "request"],
      "type": "object"
    },
    "graph": {
      "additionalProperties": false,
      "properties": {
        "content": {"type": "object"},
        "lattice": {"enum": ["honeycomb", "triangular"], "type": "string"},
        "length": {"enum": [6, 8, 10, 12, 14, 16, 18, 20], "type": "integer"},
        "path": {"pattern": "^graphs/[0-9a-f]{64}\\.json$", "type": "string"},
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["lattice", "length", "path", "sha256", "content"],
      "type": "object"
    },
    "preregistration": {
      "additionalProperties": false,
      "properties": {
        "allocation": {"$ref": "#/$defs/allocation"},
        "chain_count": {"const": 2},
        "field_factors_decimal": {
          "items": {"type": "string"},
          "maxItems": 5,
          "minItems": 5,
          "type": "array"
        },
        "lattices": {
          "items": {"type": "object"},
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "model": {"type": "object"},
        "sampling": {"type": "object"},
        "schema_version": {"const": "challenge148-paper-scan-preregistration-v1"},
        "seed_derivation": {"const": "sha256:challenge148-paper-scan-seed-v1||u64be"},
        "stage": {"const": "paper-aligned QMC_SSE finite-size reproduction"}
      },
      "required": ["schema_version", "stage", "model", "lattices", "field_factors_decimal", "chain_count", "sampling", "seed_derivation", "allocation"],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allocation": {"$ref": "#/$defs/allocation"},
    "build_info": {"$ref": "#/$defs/build_info"},
    "cells": {
      "items": {"$ref": "#/$defs/cell"},
      "maxItems": 140,
      "minItems": 140,
      "type": "array"
    },
    "graphs": {
      "items": {"$ref": "#/$defs/graph"},
      "maxItems": 14,
      "minItems": 14,
      "type": "array"
    },
    "plan_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "preregistration": {"$ref": "#/$defs/preregistration"},
    "preregistration_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "schema_version": {"const": "challenge148-paper-scan-plan-v1"},
    "seed_derivation": {"const": "sha256:challenge148-paper-scan-seed-v1||u64be"},
    "stage": {"const": "paper-aligned QMC_SSE finite-size reproduction"}
  },
  "required": ["schema_version", "stage", "preregistration", "preregistration_sha256", "seed_derivation", "allocation", "build_info", "graphs", "cells", "plan_sha256"],
  "title": "Challenge 148 paper-aligned QMC_SSE scan plan",
  "type": "object"
}
