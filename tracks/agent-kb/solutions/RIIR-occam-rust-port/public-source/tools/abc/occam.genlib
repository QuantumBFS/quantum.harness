GATE ZERO 0.0001 O=CONST0;
GATE ONE 0.0001 O=CONST1;
GATE INV 0.0001 O=!a; PIN * INV 1 999 1 0 1 0
GATE BUF 0.0001 O=a; PIN * NONINV 1 999 1 0 1 0
GATE AND2 1 O=a*b; PIN * NONINV 1 999 1 0 1 0
GATE OR2 1 O=a+b; PIN * NONINV 1 999 1 0 1 0
GATE NAND2 1 O=!(a*b); PIN * INV 1 999 1 0 1 0
GATE NOR2 1 O=!(a+b); PIN * INV 1 999 1 0 1 0
GATE XOR2 1 O=(a*!b)+(!a*b); PIN * UNKNOWN 1 999 1 0 1 0
GATE XNOR2 1 O=(a*b)+(!a*!b); PIN * UNKNOWN 1 999 1 0 1 0
