+        # The verifier must reconstruct EVERYTHING from the single vector x =
+        # ray_values via explicit index maps -- no separately-exported float
+        # matrices or scalar lambda (those created an unsound verifier that
+        # checked three unbound copies). Schema:
+        #   x = ray_values (length nvars) -- the sole primal ray
+        #   affine_map = sparse A as (constraint_k, var_position, coef)
+        #   affine_constants (all 0 for this homogeneous model)
+        #   c = objective vector (Max lambda -> c = e_{lambda_pos})
+        #   pos_var_positions[i][j,k] / gap_var_positions[l][j,k] -> position in x
+        #   lambda_var_position -> position in x
+        # The verifier rebuilds Gram matrices from x via the index maps, checks
+        # symmetry (aliasing), PSD, A*x + constants = 0, and c'x > 0.
+        all_vars = all_variables(model)
+        nvars = length(all_vars)
+        vidx = Dict(var => idx for (idx, var) in enumerate(all_vars))
+        x = value.(all_vars)
+        affmap = Tuple{Int,Int,Float64}[]
+        for k in eachindex(cons)
+            for (var, coef) in pairs(cons[k].terms)
+                push!(affmap, (k, vidx[var], Float64(coef)))
+            end
+        end
+        lambda_pos = vidx[λ]
+        cvec = zeros(Float64, nvars); cvec[lambda_pos] = 1.0
+        pos_varpos = Matrix{Int}[]
+        for i in eachindex(basis)
+            push!(pos_varpos, lb[i] > 0 ? [vidx[pos[i][j, k]] for j in 1:lb[i], k in 1:lb[i]] : zeros(Int, 0, 0))
+        end
+        gap_varpos = Matrix{Int}[]
+        for l in eachindex(gbasis)
+            push!(gap_varpos, lgb[l] > 0 ? [vidx[gpos[l][j, k]] for j in 1:lgb[l], k in 1:lgb[l]] : zeros(Int, 0, 0))
+        end
+        cert_artifact = (schema_version=1, N=N, gamma=Float64(gamma), d=d, lso=lso,
+                         termination=string(status), primal=string(_pstatus),
+                         dual=string(_dstatus), objective=Float64(_objv),
+                         nvars=nvars, nconstraints=length(cons),
+                         affine_constants=[Float64(cons[k].constant) for k in eachindex(cons)],
+                         affine_map=affmap, c=cvec,
+                         pos_var_positions=pos_varpos, gap_var_positions=gap_varpos,
+                         pos_sizes=copy(lb), gap_sizes=copy(lgb),
+                         lambda_var_position=lambda_pos, ray_values=x)
+    end
     flag = status == MathOptInterface.OPTIMAL ? 1 : 0
-    return flag
+    return (flag=flag, termination=status, primal=_pstatus, dual=_dstatus, objective=_objv,
+            cert_ray=cert_ray, cert_artifact=cert_artifact)
 end
 
