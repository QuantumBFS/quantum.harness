+    # §8 Farkas / dual-moment (SOS) certificate extraction. The upstream author
+    # left this commented; we activate it to extract the infeasibility witness
+    # when Mosek reports an INFEASIBILITY_CERTIFICATE. mmat is the dual moment
+    # matrix reconstructed from -dual(con_eq); a valid Farkas/SOS certificate
+    # requires mmat[i] ⪰ 0 for each block (validated by the caller via min-eig).
+    farkas_mmat = nothing
+    farkas_min_eig = nothing
+    if _pstatus == MathOptInterface.INFEASIBILITY_CERTIFICATE
+        dual_var = -dual.(con_eq)
+        farkas_mmat = Vector{Matrix{ComplexF64}}(undef, length(basis))
+        for i = 1:length(basis)
+            farkas_mmat[i] = zeros(ComplexF64, lb[i], lb[i])
+            for j = 1:lb[i], k = 1:lb[i]
+                @inbounds bi,c = reduce!([basis[i][j][1]; basis[i][k][1]], N)
+                if c != 0
+                    if isempty(bi)
+                        Locb = bfind(tsupp, sort([basis[i][j][2]; basis[i][k][2]]))
+                    else
+                        Locb = bfind(tsupp, sort([basis[i][j][2]; basis[i][k][2]; [bi]]))
+                    end
+                    farkas_mmat[i][j,k] = c*dual_var[Locb]
+                end
+            end
+        end
+        farkas_min_eig = [minimum(real.(eigvals(Hermitian(mm)))) for mm in farkas_mmat]
+    end
     flag = status == MathOptInterface.OPTIMAL ? 1 : 0
-    return flag
+    return (flag=flag, termination=status, primal=_pstatus, dual=_dstatus, objective=_objv,
+            farkas_mmat=farkas_mmat, farkas_min_eig=farkas_min_eig)
 end
 
