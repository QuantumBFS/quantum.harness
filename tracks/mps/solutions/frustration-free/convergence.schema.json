        "steps": {"type": "integer"}, "branch_equivalents": {"type": "integer"},
        "direct_star_mpo_width_estimate": {"type": "integer"}, "requires_chain_mapping_optimization": {"type": "boolean"}, "execution_permitted": {"type": "boolean"}
      }
