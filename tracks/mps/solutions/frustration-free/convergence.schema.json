    "calibrationSample": {
      "type": "object", "additionalProperties": false,
      "required": ["telemetry_sha256", "cell_id", "input_sha256", "request_sha256", "checkpoint_sha256", "max_link_dimension", "allocation", "rates", "checkpoint_overhead", "actual_runtime"],
      "properties": {
        "telemetry_sha256": {"$ref": "#/$defs/sha256"},
        "cell_id": {"type": "string"},
