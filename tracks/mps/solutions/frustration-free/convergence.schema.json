            "observed_cell_count": {"type": "integer", "minimum": 1},
            "total_wall_time_seconds": {"type": "number", "minimum": 0},
            "max_peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
            "peak_rss_unavailable_count": {"type": "integer", "minimum": 0},
            "peak_rss_methods": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "policy": {"type": "string"}, "analysis_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
