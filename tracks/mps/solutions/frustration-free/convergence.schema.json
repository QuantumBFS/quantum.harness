      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "artifact_type", "generator", "software_version", "plan_sha256", "base_resource_sha256", "identity", "samples", "link_dimension_groups", "checkpoint_overhead", "observed_resources", "selected_allocation", "selection_policy", "uncertainty", "calibration_sha256"],
      "properties": {
