        "nearest_energy_strictly_decreasing": {"type": "boolean"}, "finest_nearest_energy_over_temperature": {"type": ["number", "null"]},
        "finest_ratio_limit": {"type": "number"}, "passed": {"type": "boolean"}
      }
    },
    "convergenceAnalysis": {
      "type": "object", "additionalProperties": false,
