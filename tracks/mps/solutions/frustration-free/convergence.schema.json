                "min_seconds_per_step": {"type": "number", "exclusiveMinimum": 0},
                "max_seconds_per_step": {"type": "number", "exclusiveMinimum": 0}
              }
            }
          }
        },
        "checkpoint_overhead": {
          "type": "object", "additionalProperties": false,
          "required": ["mean_write_seconds", "max_write_seconds", "mean_read_seconds", "max_read_seconds", "max_size_bytes"],
