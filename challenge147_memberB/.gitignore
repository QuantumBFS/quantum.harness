# generated run outputs (per design spec: results stay out of git)
metts_runs/*/
metts_runs/*/traces/
metts_runs/*/checkpoints/
metts_runs/*/logs/*.log
# but keep reports (deliverables) and the empty directory structure markers
!metts_runs/reports/
!metts_runs/.gitkeep

# python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
